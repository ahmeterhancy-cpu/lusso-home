# Turhost: hesap PHP sürümünden bağımsız olarak bu site PHP 8.3 ile çalışır (CloudLinux alt-php83).
<FilesMatch "\.php$">
    SetHandler application/x-httpd-alt-php83___lsphp
</FilesMatch>

# Tek adres: www ve geçici yeni.* → https://lussohomeconcept.com
# Eski WordPress dosya/panel adresleri → eski.lussohomeconcept.com (eski bağlantılar ve görseller kırılmasın)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^(www|yeni)\.lussohomeconcept\.com$ [NC]
    RewriteRule ^ https://lussohomeconcept.com%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^lussohomeconcept\.com$ [NC]
    RewriteRule ^(wp-content|wp-includes|wp-admin|wp-json)(/.*)?$ https://eski.lussohomeconcept.com%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTP_HOST} ^lussohomeconcept\.com$ [NC]
    RewriteRule ^wp-login\.php$ https://eski.lussohomeconcept.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Her zaman https: oturum çerezleri yalnız https'te geçerli; http'de panel girişi "sayfa süresi doldu" ile düşer.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Geçici adres (yeni.*) arama motorlarına kapalı.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^yeni\. [NC]
    RewriteRule .* - [E=LUSSO_NOINDEX:1]
</IfModule>
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow" env=LUSSO_NOINDEX
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
